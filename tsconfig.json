{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", ".github/scripts/**/*.ts", "tests/**/*.ts"]
}
