---
import ServiceStatus from "../components/ServiceStatus";
import "../styles/global.css";

const steps = [
  { number: "01", title: "대화는 자연스럽게", text: "팀의 공식 Slack 채널에서 평소처럼 소통하세요." },
  { number: "02", title: "관찰은 근거와 함께", text: "네 가지 커뮤니케이션 역량을 대화의 맥락으로 살펴봅니다." },
  { number: "03", title: "판단은 교수님이", text: "원문 근거와 불확실성을 검토하고 최종 평가를 완성합니다." },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="팀 프로젝트의 대화에서 커뮤니케이션의 근거를 찾는 교수용 평가 지원 도구, TeamPlanet." />
    <meta name="color-scheme" content="light" />
    <title>TeamPlanet — 대화에서 발견하는 협업</title>
  </head>
  <body>
    <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-6 md:px-12">
      <header class="flex items-center justify-between border-b border-ink/10 py-7">
        <a href="/" class="flex items-center gap-3 text-xl font-semibold tracking-tight no-underline" aria-label="TeamPlanet 홈">
          <span class="brand-mark" aria-hidden="true"></span><span>TeamPlanet</span>
        </a>
        <span class="rounded-full border border-ink/15 px-3 py-1.5 text-xs text-ink/60">교수용 워크스페이스</span>
      </header>
      <main class="flex-1">
        <section class="max-w-3xl py-20 md:py-28">
          <p class="mb-6 text-xs font-semibold tracking-[.2em] text-forest">A BETTER VIEW OF TEAMWORK</p>
          <h1 class="text-4xl font-semibold leading-[1.3] tracking-tight md:text-6xl">팀의 대화에서,<br />협업의 근거를 찾다.</h1>
          <p class="mt-7 max-w-xl text-base leading-8 text-ink/65 md:text-lg">결과물만으로는 보이지 않는 팀의 과정.<br class="hidden md:block" /> TeamPlanet은 실제 대화를 바탕으로 학생의 소통과 협업을 살펴볼 수 있도록 돕습니다.</p>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <span class="rounded-lg bg-forest px-5 py-3 text-sm font-medium text-white">워크스페이스 준비 중</span>
            <span class="text-xs text-ink/55">교수 로그인과 Slack 연결이 곧 추가됩니다.</span>
          </div>
        </section>
        <section class="grid gap-8 border-t border-ink/15 py-10 md:grid-cols-3 md:gap-12" aria-label="TeamPlanet 이용 흐름">
          {steps.map(step => (
            <article>
              <p class="mb-5 font-mono text-xs text-forest">{step.number} /</p>
              <h2 class="mb-3 text-lg font-semibold">{step.title}</h2>
              <p class="max-w-xs text-sm leading-7 text-ink/60">{step.text}</p>
            </article>
          ))}
        </section>
        <aside class="mb-12 rounded-xl border border-ink/10 bg-white/50 px-5 py-4 text-xs leading-6 text-ink/55">수집과 분석은 고지·동의된 공식 채널에 한해 진행됩니다. 현재는 초기 화면이며 대화 수집과 AI 분석은 아직 활성화되지 않았습니다.</aside>
      </main>
      <footer class="flex flex-wrap items-center justify-between gap-4 border-t border-ink/10 py-6">
        <p class="text-xs text-ink/45">TeamPlanet · 대화를 이해하는 새로운 시선</p>
        <ServiceStatus client:load />
      </footer>
    </div>
  </body>
</html>
