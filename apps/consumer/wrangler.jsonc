{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "teamplanet-consumer",
  "account_id": "d09b11497e0618d6dceff0559855a7b2",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB", "database_name": "teamplanet-production",
    "database_id": "086fd3c2-d33b-4fc2-9a6c-91df7305c8b9", "migrations_dir": "../../packages/db/migrations"
  }],
  "queues": {
    "producers": [
      { "binding": "WORK_QUEUE", "queue": "teamplanet-jobs" },
      { "binding": "DEAD_LETTER_QUEUE", "queue": "teamplanet-jobs-dlq" }
    ],
    "consumers": [{
      "queue": "teamplanet-jobs", "max_batch_size": 10, "max_batch_timeout": 1,
      "max_retries": 4, "retry_delay": 2, "dead_letter_queue": "teamplanet-jobs-dlq"
    }]
  },
  "triggers": { "crons": ["* * * * *"] }
}
